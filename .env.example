# ==========================================================================
# Application
# ==========================================================================
APP_NAME="FastAPI RAG Backend"
ENV=development
DEBUG=true
# Comma separated list of allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# ==========================================================================
# Database (PostgreSQL + pgvector)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# ==========================================================================
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb

# ==========================================================================
# JWT auth
# Generate a strong secret, e.g.:  openssl rand -hex 32
# ==========================================================================
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================================================
# Embeddings
# EMBEDDING_PROVIDER: local | voyage | openai
#   local  -> deterministic, dependency-free (great for dev/tests/offline)
#   voyage -> Voyage AI (Anthropic's recommended embedding provider)
#   openai -> any OpenAI-compatible /v1/embeddings endpoint
# EMBEDDING_DIM must match the provider/model output dimension.
#   local: any value you choose (default 384)
#   voyage voyage-3: 1024 | openai text-embedding-3-small: 1536
# NOTE: changing EMBEDDING_DIM changes the DB vector column size; recreate the
#       `chunks` table / volume if you change it after data already exists.
# ==========================================================================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-384
EMBEDDING_DIM=384

VOYAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================================================
# LLM (Anthropic Claude) — powers the /chat endpoint
# Get a key at https://console.anthropic.com
# ==========================================================================
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# On Claude Opus 5 thinking is on by default and shares this budget with the
# answer text — keep headroom so answers are not truncated mid-sentence.
LLM_MAX_TOKENS=4096

# ==========================================================================
# Redis (response + embedding cache, ingestion job status)
# ==========================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ==========================================================================
# Document ingestion
# INGEST_MODE: sync | background | kafka
#   sync       -> chunk + embed inside the request (simplest)
#   background -> FastAPI BackgroundTasks (returns immediately, processes async)
#   kafka      -> publish to Kafka; a separate worker consumes & processes
# ==========================================================================
INGEST_MODE=background
CHUNK_SIZE=200
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5

# ==========================================================================
# Kafka (only used when INGEST_MODE=kafka)
# ==========================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGEST_TOPIC=document.ingest
KAFKA_GROUP_ID=rag-ingest-workers
